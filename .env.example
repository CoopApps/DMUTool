# --- Server ---
PORT=3000
TZ=Europe/London
# Set to 1 to disable scheduled cron jobs (useful for migration / scripts).
DISABLE_CRON=0

# --- Database ---
# Path to the SQLite file (defaults to db/dmu.sqlite).
DB_PATH=

# --- Access database migration ---
# Path to the uploaded Access backup used by scripts/migrate.js.
ACCESS_DB_PATH=/path/to/MP_Contact_Database__DESIGN__Backup.accdb

# --- Contensis (DMU content) ---
# IT-approved published delivery credentials.
CONTENSIS_ROOT_URL=https://cms-dmu.cloud.contensis.com
CONTENSIS_ACCESS_TOKEN=uGIVAIkICmZu3vz7B9rBgLu7S7OTWhusUQn1f4YgJNZ1kyon
CONTENSIS_PROJECT_ID=website

# --- Guardian Open Platform (sector news, optional) ---
# Free developer key from https://open-platform.theguardian.com/access/
# Leave blank to skip the Guardian API (the Guardian HE RSS feed still runs).
GUARDIAN_API_KEY=

# --- TheyWorkForYou (richer MP intelligence, optional) ---
# Free key from https://www.theyworkforyou.com/api/key
TWFY_API_KEY=

# --- Morning email digest (optional) ---
# Leave SMTP_HOST/DIGEST_TO blank to disable the daily email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=
# Used for the "open the full digest" link in the email.
APP_URL=http://localhost:3000

# --- Claude API (semantic matching + drafting) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
